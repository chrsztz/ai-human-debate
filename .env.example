# 复制成 .env 再填
OPENAI_API_KEY=sk-...

# 没有 key 也能把整条链路跑起来验证 UI（向量是噪声，读数没有语义意义）
# MOCK_OPENAI=1

# ── 模型 ────────────────────────────────────────────────
OPENAI_CHAT_MODEL=gpt-4o
# text-embedding-3-large 的多语言质量足够，中英混杂的辩论不用另外上本地模型
OPENAI_EMBED_MODEL=text-embedding-3-large
# 3-large 原生 3072 维；截到 1024 对语义差分投影没有可感损失。设 0 用原生维度
OPENAI_EMBED_DIMS=1024

# ── 辩论 ────────────────────────────────────────────────
# 辩题写成陈述句，正/反方才没有歧义（"微信聊天应该用句号"，不是"该不该用句号"）
DEBATE_MOTION=
# random = 抽签定边（推荐）。人自己选一定选自己真信的那边，AI 就永远是唱反调的那个，
# 会在每一场里对 affiliation 轴造成同向偏差
SIDE_ASSIGN=random
# 强制 AI 站哪边：pro / con。留空 = 按 SIDE_ASSIGN
AI_SIDE=

# 回合长度失衡会让节奏塌掉：人打两句话、模型回四百字 = 人 8 秒 AI 45 秒
CHAT_MAX_TOKENS=400
CHAT_TEMPERATURE=1.0
CHAT_LENGTH_HINT=（请用不超过 120 字回应，直接进入论点，不要罗列条目。）

# ── prompt 的两个槽，别混 ───────────────────────────────
# 任务约束：不给立场，模型只会顺着人的话往下写，两边论证同一边。跟长度约束同类
# 注意要用双引号，dotenv 只在双引号里解释 \n
DEBATE_FRAME="这是一场辩论。\n辩题：{motion}\n你的立场：{side}。\n请始终从这个立场发言，不要替对方论证。"
# 人格注入：v1 留空 —— 要测的就是"没有人格"时的默认语域。做 A/B 对照版本时才填
CHAT_SYSTEM_PROMPT=

# ── 切片 ────────────────────────────────────────────────
# clause = 按标点切子句（推荐）；fixed = 定长切片
SEGMENT_MODE=clause
# 宽度单位：全角字符算 2，拉丁字符算 1
SEG_TARGET_WIDTH=56
SEG_MIN_WIDTH=16
SEG_MAX_WIDTH=120

# ── 轴 ──────────────────────────────────────────────────
# 把后面的轴中能被前面的轴解释掉的分量减掉。四条轴高度相关时打开
AXES_ORTHOGONALIZE=0

# ── 校准 ────────────────────────────────────────────────
# fixed（排练前） / fitted（跑过 fit_calibration.py 之后） / running（做实验用，演出别用）
CALIB_MODE=fixed
CALIB_PRIOR_MU=0.0
CALIB_PRIOR_SIGMA=0.08
CALIB_GAIN=0.7
